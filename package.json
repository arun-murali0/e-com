{
  "name": "e-commerce",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@apps/web",
    "dev:dashboard": "turbo run dev --filter=@apps/dashboard",
    "dev:backend": "turbo run dev --filter=@services/backend",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@apps/web",
    "build:dashboard": "turbo run build --filter=@apps/dashboard",
    "build:backend": "turbo run build --filter=@services/backend",
    "lint": "oxlint --ignore-path .gitignore",
    "lint:fix": "oxlint --ignore-path .gitignore --fix",
    "typecheck": "turbo run typecheck",
    "clean": "git clean -xdf node_modules .turbo dist .next"
  },
  "devDependencies": {
    "oxlint": "^1.78.0",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
