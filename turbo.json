{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["packages/tsconfig/**/*.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        "next.config.js"
      ],
      "env": ["NEXT_PUBLIC_API_URL", "VITE_API_URL", "PORT"]
    },
    "typecheck": {
      "outputs": [],
      "inputs": ["src/**", "tsconfig.json"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["src/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
